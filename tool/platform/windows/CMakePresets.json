{
	"version": 5,
	"configurePresets": [
		{
			"name": "windows-default",
			"hidden": true,
			"description": "Base preset for Windows configurations",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}",
			"cacheVariables": {
				"CMAKE_PROJECT_TOP_LEVEL_INCLUDES": {
					"type": "FILEPATH",
					"value": "${sourceDir}/tool/conan/conan_provider.cmake"
				},
				"CMAKE_CONFIGURATION_TYPES": "Debug;Release"
			},
			"architecture": {
				"value": "x64"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-ninja-msvc",
			"displayName": "Ninja - MSVC",
			"description": "Default configuration using Ninja Multi-Config generator and the Microsoft Visual C++ compiler",
			"architecture": {
				"strategy": "external"
			},
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-msbuild-msvc",
			"displayName": "MSBuild - MSVC",
			"description": "Default configuration using MSBuild and the Microsoft Visual C++ compiler",
			"generator": "Visual Studio 17 2022",
			"architecture": {
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-ninja-clang",
			"displayName": "Ninja - Clang",
			"description": "Default configuration using Ninja Multi-Config generator and Clang",
			"architecture": {
				"strategy": "external"
			},
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "clang-cl"
			}
		},
		{
			"name": "windows-msbuild-clang",
			"displayName": "MSBuild - Clang",
			"description": "Default configuration using MSBuild and Clang",
			"generator": "Visual Studio 17 2022",
			"architecture": {
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			],
			"toolset": "ClangCL"
		}
	],
	"buildPresets": [
		{
			"name": "windows-default",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "release",
			"displayName": "Ninja - MSVC: Release",
			"configurePreset": "windows-ninja-msvc"
		},
		{
			"name": "debug",
			"displayName": "Ninja - MSVC: Debug",
			"configurePreset": "windows-ninja-msvc"
		}
	],
	"testPresets": [
		{
			"name": "windows-default",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"output": {
				"outputOnFailure": true,
				"shortProgress": true
			},
			"execution": {
				"noTestsAction": "error",
				"stopOnFailure": true
			}
		}
	]
}