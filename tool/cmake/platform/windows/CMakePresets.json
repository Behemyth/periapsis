			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			],
			"toolset": "ClangCL"
		},
		{
			"name": "windows-ninja-msvc-release",
			"inherits": [
				"cppython-release",
				"windows-ninja-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
