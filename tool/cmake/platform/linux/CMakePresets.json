{
	"version": 9,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "linux-default",
			"inherits": [
				"default"
			],
			"hidden": true,
			"description": "Base preset for Linux configurations",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"cacheVariables": {
				"CMAKE_C_FLAGS_INIT": "-Wall -Wextra -Wpedantic",
				"CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic"
			}
		},
		{
			"name": "linux-ninja-gcc",
			"displayName": "Ninja GCC",
			"description": "Ninja Multi-Config generator with GCC",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"linux-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "linux-ninja-clang-libcxx",
			"displayName": "Ninja upstream Clang libc++",
			"description": "Ninja Multi-Config generator with upstream Clang and libc++ from LLVM_ROOT",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"linux-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "$env{LLVM_ROOT}/bin/clang",
				"CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang++",
				"CMAKE_CXX_FLAGS": "-stdlib=libc++",
				"CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
				"CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++"
			}
		},
		{
			"name": "linux-ninja-clang-libcxx-sanitize",
			"displayName": "Ninja upstream Clang libc++ ASan UBSan",
			"description": "Upstream Clang and libc++ with AddressSanitizer and UndefinedBehaviorSanitizer",
			"inherits": [
				"linux-ninja-clang-libcxx"
			],
			"cacheVariables": {
				"CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
				"CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined",
				"CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined"
			}
		},
		{
			"name": "linux-ninja-gcc-release",
			"inherits": [
				"cppython-release",
				"linux-ninja-gcc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "linux-ninja-gcc-development",
			"inherits": [
				"cppython-debug",
				"linux-ninja-gcc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "linux-ninja-gcc-debug",
			"inherits": [
				"cppython-debug",
				"linux-ninja-gcc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "linux-ninja-clang-libcxx-debug",
			"inherits": [
				"cppython-debug",
				"linux-ninja-clang-libcxx"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "linux-ninja-clang-libcxx-development",
			"inherits": [
				"cppython-debug",
				"linux-ninja-clang-libcxx"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "linux-ninja-clang-libcxx-release",
			"inherits": [
				"cppython-release",
				"linux-ninja-clang-libcxx"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "linux-ninja-clang-libcxx-sanitize-debug",
			"inherits": [
				"cppython-debug",
				"linux-ninja-clang-libcxx-sanitize"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "linux-default",
			"hidden": true,
			"inherits": [
				"default"
			],
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "linux-ninja-gcc-release",
			"displayName": "Ninja GCC Release",
			"configurePreset": "linux-ninja-gcc-release",
			"configuration": "Release",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-gcc-development",
			"displayName": "Ninja GCC Development",
			"configurePreset": "linux-ninja-gcc-development",
			"configuration": "Development",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-gcc-debug",
			"displayName": "Ninja GCC Debug",
			"configurePreset": "linux-ninja-gcc-debug",
			"configuration": "Debug",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-clang-libcxx-debug",
			"displayName": "Ninja upstream Clang libc++ Debug",
			"configurePreset": "linux-ninja-clang-libcxx-debug",
			"configuration": "Debug",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-clang-libcxx-development",
			"displayName": "Ninja upstream Clang libc++ Development",
			"configurePreset": "linux-ninja-clang-libcxx-development",
			"configuration": "Development",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-clang-libcxx-release",
			"displayName": "Ninja upstream Clang libc++ Release",
			"configurePreset": "linux-ninja-clang-libcxx-release",
			"configuration": "Release",
			"inherits": [
				"linux-default"
			]
		},
		{
			"name": "linux-ninja-clang-libcxx-sanitize-debug",
			"displayName": "Ninja upstream Clang libc++ ASan UBSan Debug",
			"configurePreset": "linux-ninja-clang-libcxx-sanitize-debug",
			"configuration": "Debug",
			"inherits": [
				"linux-default"
			]
		}
	],
	"testPresets": [
		{
			"name": "linux-default",
			"hidden": true,
			"inherits": [
				"default"
			]
		},
		{
			"name": "linux-ninja-gcc-debug",
			"displayName": "Ninja GCC Debug",
			"configurePreset": "linux-ninja-gcc-debug",
			"inherits": [
				"linux-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "linux-ninja-gcc-development",
			"displayName": "Ninja GCC Development",
			"configurePreset": "linux-ninja-gcc-development",
			"inherits": [
				"linux-default"
			],
			"configuration": "Development"
		},
		{
			"name": "linux-ninja-gcc-release",
			"displayName": "Ninja GCC Release",
			"configurePreset": "linux-ninja-gcc-release",
			"inherits": [
				"linux-default"
			],
			"configuration": "Release"
		},
		{
			"name": "linux-ninja-gcc-bench-debug",
			"displayName": "Ninja GCC Bench Debug",
			"configurePreset": "linux-ninja-gcc-debug",
			"inherits": [
				"default-bench",
				"linux-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "linux-ninja-gcc-bench-development",
			"displayName": "Ninja GCC Bench Development",
			"configurePreset": "linux-ninja-gcc-development",
			"inherits": [
				"default-bench",
				"linux-default"
			],
			"configuration": "Development"
		},
		{
			"name": "linux-ninja-gcc-bench-release",
			"displayName": "Ninja GCC Bench Release",
			"configurePreset": "linux-ninja-gcc-release",
			"inherits": [
				"default-bench",
				"linux-default"
			],
			"configuration": "Release"
		},
		{
			"name": "linux-ninja-clang-libcxx-debug",
			"displayName": "Ninja upstream Clang libc++ Debug",
			"configurePreset": "linux-ninja-clang-libcxx-debug",
			"inherits": [
				"linux-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "linux-ninja-clang-libcxx-development",
			"displayName": "Ninja upstream Clang libc++ Development",
			"configurePreset": "linux-ninja-clang-libcxx-development",
			"inherits": [
				"linux-default"
			],
			"configuration": "Development"
		},
		{
			"name": "linux-ninja-clang-libcxx-release",
			"displayName": "Ninja upstream Clang libc++ Release",
			"configurePreset": "linux-ninja-clang-libcxx-release",
			"inherits": [
				"linux-default"
			],
			"configuration": "Release"
		},
		{
			"name": "linux-ninja-clang-libcxx-sanitize-debug",
			"displayName": "Ninja upstream Clang libc++ ASan UBSan Debug",
			"configurePreset": "linux-ninja-clang-libcxx-sanitize-debug",
			"inherits": [
				"linux-default"
			],
			"configuration": "Debug",
			"environment": {
				"ASAN_OPTIONS": "abort_on_error=1:detect_leaks=1:strict_string_checks=1",
				"UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
			}
		}
	]
}
