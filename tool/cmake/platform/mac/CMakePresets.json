{
	"version": 9,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "macos-default",
			"inherits": [
				"default"
			],
			"hidden": true,
			"description": "Base preset for macOS configurations",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			},
			"cacheVariables": {
				"CMAKE_C_FLAGS_INIT": "-Wall -Wextra -Wpedantic",
				"CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic"
			}
		},
		{
			"name": "macos-ninja-clang",
			"displayName": "Ninja Clang",
			"description": "Ninja Multi-Config generator with Apple Clang",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-llvm-libcxx",
			"displayName": "Ninja upstream LLVM libc++",
			"description": "Ninja Multi-Config generator with upstream Clang and libc++ from LLVM_ROOT",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"macos-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "$env{LLVM_ROOT}/bin/clang",
				"CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang++",
				"CMAKE_CXX_FLAGS": "-stdlib=libc++",
				"CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -L$env{LLVM_ROOT}/lib/c++ -Wl,-rpath,$env{LLVM_ROOT}/lib/c++ -L$env{LLVM_ROOT}/lib/unwind -lunwind",
				"CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -L$env{LLVM_ROOT}/lib/c++ -Wl,-rpath,$env{LLVM_ROOT}/lib/c++ -L$env{LLVM_ROOT}/lib/unwind -lunwind"
			}
		},
		{
			"name": "macos-ninja-clang-release",
			"inherits": [
				"cppython-release",
				"macos-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "macos-ninja-clang-development",
			"inherits": [
				"cppython-debug",
				"macos-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "macos-ninja-clang-debug",
			"inherits": [
				"cppython-debug",
				"macos-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "macos-ninja-llvm-libcxx-debug",
			"inherits": [
				"cppython-debug",
				"macos-ninja-llvm-libcxx"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "macos-ninja-llvm-libcxx-development",
			"inherits": [
				"cppython-debug",
				"macos-ninja-llvm-libcxx"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "macos-ninja-llvm-libcxx-release",
			"inherits": [
				"cppython-release",
				"macos-ninja-llvm-libcxx"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "macos-default",
			"hidden": true,
			"inherits": [
				"default"
			],
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Darwin"
			}
		},
		{
			"name": "macos-ninja-clang-release",
			"displayName": "Ninja Clang Release",
			"configurePreset": "macos-ninja-clang-release",
			"configuration": "Release",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-clang-development",
			"displayName": "Ninja Clang Development",
			"configurePreset": "macos-ninja-clang-development",
			"configuration": "Development",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-clang-debug",
			"displayName": "Ninja Clang Debug",
			"configurePreset": "macos-ninja-clang-debug",
			"configuration": "Debug",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-llvm-libcxx-debug",
			"displayName": "Ninja upstream LLVM libc++ Debug",
			"configurePreset": "macos-ninja-llvm-libcxx-debug",
			"configuration": "Debug",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-llvm-libcxx-development",
			"displayName": "Ninja upstream LLVM libc++ Development",
			"configurePreset": "macos-ninja-llvm-libcxx-development",
			"configuration": "Development",
			"inherits": [
				"macos-default"
			]
		},
		{
			"name": "macos-ninja-llvm-libcxx-release",
			"displayName": "Ninja upstream LLVM libc++ Release",
			"configurePreset": "macos-ninja-llvm-libcxx-release",
			"configuration": "Release",
			"inherits": [
				"macos-default"
			]
		}
	],
	"testPresets": [
		{
			"name": "macos-default",
			"hidden": true,
			"inherits": [
				"default"
			]
		},
		{
			"name": "macos-ninja-clang-debug",
			"displayName": "Ninja Clang Debug",
			"configurePreset": "macos-ninja-clang-debug",
			"inherits": [
				"macos-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "macos-ninja-clang-development",
			"displayName": "Ninja Clang Development",
			"configurePreset": "macos-ninja-clang-development",
			"inherits": [
				"macos-default"
			],
			"configuration": "Development"
		},
		{
			"name": "macos-ninja-clang-release",
			"displayName": "Ninja Clang Release",
			"configurePreset": "macos-ninja-clang-release",
			"inherits": [
				"macos-default"
			],
			"configuration": "Release"
		},
		{
			"name": "macos-ninja-clang-bench-debug",
			"displayName": "Ninja Clang Bench Debug",
			"configurePreset": "macos-ninja-clang-debug",
			"inherits": [
				"default-bench",
				"macos-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "macos-ninja-clang-bench-development",
			"displayName": "Ninja Clang Bench Development",
			"configurePreset": "macos-ninja-clang-development",
			"inherits": [
				"default-bench",
				"macos-default"
			],
			"configuration": "Development"
		},
		{
			"name": "macos-ninja-clang-bench-release",
			"displayName": "Ninja Clang Bench Release",
			"configurePreset": "macos-ninja-clang-release",
			"inherits": [
				"default-bench",
				"macos-default"
			],
			"configuration": "Release"
		},
		{
			"name": "macos-ninja-llvm-libcxx-debug",
			"displayName": "Ninja upstream LLVM libc++ Debug",
			"configurePreset": "macos-ninja-llvm-libcxx-debug",
			"inherits": [
				"macos-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "macos-ninja-llvm-libcxx-development",
			"displayName": "Ninja upstream LLVM libc++ Development",
			"configurePreset": "macos-ninja-llvm-libcxx-development",
			"inherits": [
				"macos-default"
			],
			"configuration": "Development"
		},
		{
			"name": "macos-ninja-llvm-libcxx-release",
			"displayName": "Ninja upstream LLVM libc++ Release",
			"configurePreset": "macos-ninja-llvm-libcxx-release",
			"inherits": [
				"macos-default"
			],
			"configuration": "Release"
		}
	]
}
