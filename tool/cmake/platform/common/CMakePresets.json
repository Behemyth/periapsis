{
    "version": 10,
    "configurePresets": [
        {
            "name": "default",
            "description": "Base preset for all identities",
            "hidden": true,
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "CMAKE_COMPILE_WARNING_AS_ERROR": {
                    "type": "BOOL",
                    "value": "$env{SYNODIC_STRICT_WARNINGS}"
                },
                "CMAKE_CXX_STDLIB_MODULES_JSON": "$env{SYNODIC_CXX_STDLIB_MODULES_JSON}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "hidden": true
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "hidden": true,
            "output": {
                "outputOnFailure": true,
                "shortProgress": true,
                "debug": true,
                "verbosity": "verbose"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            },
            "filter": {
                "exclude": {
                    "label": "benchmark"
                }
            }
        },
        {
            "name": "default-bench",
            "description": "Base preset for benchmark tests",
            "hidden": true,
            "output": {
                "outputOnFailure": true,
                "shortProgress": true,
                "debug": true,
                "verbosity": "verbose"
            },
            "filter": {
                "include": {
                    "label": "benchmark"
                }
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}
