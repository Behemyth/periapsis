{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 1
    },
    "include": [
        "tool/cppython/cppython.json"
    ],
    "configurePresets": [
        {
            "name": "default",
            "inherits": [
                "cppython"
            ],
            "hidden": true,
            "description": "Base preset for all configurations",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}"
        },
        {
            "name": "windows-default",
            "inherits": "default",
            "hidden": true,
            "description": "Base preset for Windows configurations",
            "architecture": {
                "value": "x64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-default",
            "inherits": "default",
            "hidden": true,
            "description": "Base preset for Linux configurations",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-default",
            "inherits": "default",
            "hidden": true,
            "description": "Base preset for MacOS configurations",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-ninja-msvc",
            "displayName": "Ninja - MSVC",
            "description": "Default configuration using Ninja Multi-Config generator and the Microsoft Visual C++ compiler",
            "architecture": {
                "strategy": "external"
            },
            "inherits": [
                "windows-default"
            ]
        },
        {
            "name": "windows-msbuild-msvc",
            "displayName": "MSBuild - MSVC",
            "description": "Default configuration using MSBuild and the Microsoft Visual C++ compiler",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "strategy": "set"
            },
            "inherits": [
                "windows-default"
            ]
        },
        {
            "name": "windows-ninja-clang",
            "displayName": "Ninja - Clang",
            "description": "Default configuration using Ninja Multi-Config generator and Clang",
            "architecture": {
                "strategy": "external"
            },
            "inherits": [
                "windows-default"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "windows-msbuild-clang",
            "displayName": "MSBuild - Clang",
            "description": "Default configuration using MSBuild and Clang",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "strategy": "set"
            },
            "inherits": [
                "windows-default"
            ],
            "toolset": "ClangCL"
        },
        {
            "name": "linux-ninja-gcc",
            "displayName": "Ninja - GCC",
            "description": "Default configuration using Ninja and GCC",
            "inherits": [
                "linux-default"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++-9"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-default",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-default",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-default",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-ninja-msvc-debug",
            "displayName": "Debug",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-ninja-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-ninja-msvc-release",
            "displayName": "Release",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-ninja-msvc",
            "configuration": "Release"
        },
        {
            "name": "windows-ninja-msvc-development",
            "displayName": "Development",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-ninja-msvc",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-msbuild-msvc-debug",
            "displayName": "Debug",
            "description": "",
