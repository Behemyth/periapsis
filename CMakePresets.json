            "displayName": "Release",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-ninja-clang",
            "configuration": "Release"
        },
        {
            "name": "windows-ninja-clang-development",
            "displayName": "Development",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-ninja-clang",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "windows-msbuild-clang-debug",
            "displayName": "Debug",
