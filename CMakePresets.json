                "windows-default"
            ],
            "configurePreset": "windows-msbuild-clang",
            "configuration": "Debug"
        },
        {
            "name": "windows-msbuild-clang-release",
            "displayName": "Release",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-msbuild-clang",
            "configuration": "Release"
        },
        {
            "name": "windows-msbuild-clang-development",
            "displayName": "Development",
            "description": "",
            "inherits": [
                "windows-default"
            ],
            "configurePreset": "windows-msbuild-clang",
